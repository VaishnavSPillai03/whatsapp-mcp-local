{
  "name": "whatsapp-mcp-local",
  "version": "1.0.0",
  "type": "module",
  "description": "Read-only WhatsApp MCP server that runs entirely on your machine. Gives Claude your chat history as context, with LID address resolution.",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "whatsapp-mcp-local": "src/setup.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "whatsapp",
    "mcp",
    "model-context-protocol",
    "claude",
    "baileys",
    "read-only",
    "lid",
    "self-hosted"
  ],
  "scripts": {
    "setup": "node src/setup.js",
    "bridge": "node src/bridge.js",
    "mcp": "node src/mcp-server.js",
    "lid": "node src/lid-import.js",
    "stats": "node src/stats.js",
    "test": "node test/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "7.0.0-rc14",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  }
}
